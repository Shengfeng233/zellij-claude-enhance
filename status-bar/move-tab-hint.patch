+fn move_tab_keys(binds: &[(KeyWithModifier, Vec<Action>)]) -> Vec<KeyWithModifier> {
+    let mut keys = vec![];
+    for (direction, preferred) in [(Direction::Left, 'i'), (Direction::Right, 'o')] {
+        let candidates = action_key(binds, &[Action::MoveTab { direction }]);
+        if let Some(key) = candidates
+            .iter()
+            .find(|k| k.is_key_with_alt_modifier(BareKey::Char(preferred)))
+            .or_else(|| candidates.iter().next())
+        {
+            keys.push(key.clone());
+        }
+    }
+    keys
+}
+
+fn move_tab_shortcut(
+    help: &ModeInfo,
+    keys: &Vec<KeyWithModifier>,
+    common_modifiers: &Vec<KeyModifier>,
+) -> LinePart {
+    if common_modifiers.is_empty() {
+        return add_shortcut(help, "Move Tab", keys, false, Some(0));
+    }
+    // Inside the "Alt + ..." group only keys carrying that prefix make sense.
+    if !keys.iter().all(|k| k.has_modifiers(common_modifiers)) {
+        return LinePart::default();
+    }
+    let keys = keys
+        .iter()
+        .map(|k| k.strip_common_modifiers(common_modifiers))
+        .collect();
+    add_shortcut_with_inline_key(help, "Move Tab", keys, false)
+}
