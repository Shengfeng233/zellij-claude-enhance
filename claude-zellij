#!/usr/bin/env bash
# claude-zellij
# Start interactive Claude sessions inside Zellij with per-pane recovery.
#
# Recovery model:
#   1. Generates a marker UUID and re-execs itself with --zellij-marker <uuid>
#      so Zellij serializes the marker in the pane command.
#   2. Starts claude --session-id <uuid> as a child process (not exec), which
#      prevents MCP child processes from being discovered by Zellij instead of claude.
#   3. A background watcher monitors ~/.claude/history.jsonl for /resume commands.
#      When the user switches sessions via /resume, the watcher updates the stored
#      session ID so resurrection lands on the correct conversation.
#   4. On resurrection or Ctrl+Y reboot, the wrapper reads the stored session ID
#      and runs claude --resume <session-id>.

set -euo pipefail

MARKER_DIR="$HOME/.local/share/claude-zellij/markers"
HELPER_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude-zellij-pty.py"

# Subcommands that should pass through unchanged
readonly SUBCOMMANDS="auth mcp doctor update upgrade setup-token install agents plugin plugins"

# Flags that indicate non-default invocations we should not inject into
readonly PASSTHROUGH_FLAGS="-c --continue -r --resume --session-id -p --print -h --help -v --version"

start_history_watcher() {
    local marker_file="$1"
    local initial_session_id="$2"
    local history_file="$HOME/.claude/history.jsonl"
    local wrapper_pid="$$"
    local watcher_pid_file="${marker_file}.watcher"
    local existing_watcher_pid=""

    if [[ -f "$watcher_pid_file" ]]; then
        existing_watcher_pid="$(cat "$watcher_pid_file" 2>/dev/null || true)"
        if [[ -n "$existing_watcher_pid" ]] && kill -0 "$existing_watcher_pid" 2>/dev/null; then
            return
        fi
    fi

    (
        trap '' INT TERM HUP  # Don't die from signals meant for claude
        local current="$initial_session_id"
        local last_lines
        local saw_resume=false
        local now_lines
        local line
        local sid
        local target

        last_lines="$(wc -l < "$history_file" 2>/dev/null || echo 0)"

        while kill -0 "$wrapper_pid" 2>/dev/null; do
            sleep 3
            now_lines="$(wc -l < "$history_file" 2>/dev/null || echo 0)"
            [[ "$now_lines" -le "$last_lines" ]] && continue

            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                sid="$(echo "$line" | grep -o '"sessionId":"[^"]*"' | head -1 | sed 's/"sessionId":"//;s/"//')"
                [[ -z "$sid" ]] && continue

                if [[ "$sid" == "$current" ]] && echo "$line" | grep -q '"display":"/resume'; then
                    saw_resume=true
                    target="$(echo "$line" | grep -o '"display":"/resume [^"]*"' | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' || true)"
                    if [[ -n "$target" && "$target" != "$current" ]]; then
                        echo "$target" > "$marker_file"
                        current="$target"
                        saw_resume=false
                    fi
                    continue
                fi

                if $saw_resume && [[ "$sid" != "$current" ]]; then
                    echo "$sid" > "$marker_file"
                    current="$sid"
                    saw_resume=false
                fi
            done < <(tail -n +"$((last_lines + 1))" "$history_file" 2>/dev/null)

            last_lines="$now_lines"
        done
    ) &
    echo "$!" > "$watcher_pid_file"
    disown
}

launch_claude_with_hotkey() {
    local marker="$1"
    shift
    local wrapper_args=("$@")
    exec "$HELPER_PATH" --wrapper "$0" --marker "$marker" "${wrapper_args[@]}" -- "${CLAUDE_CMD[@]}"
}

# --- Parse --zellij-marker (our internal flag, not a claude flag) ---
MARKER=""
ARGS=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--zellij-marker" && -n "${2:-}" ]]; then
        MARKER="$2"
        shift 2
    else
        ARGS+=("$1")
        shift
    fi
done
set -- "${ARGS[@]}"

# --- Check for passthrough flags and subcommands ---
first_non_flag=""
for arg in "$@"; do
    for flag in $PASSTHROUGH_FLAGS; do
        [[ "$arg" == "$flag" ]] && exec claude "$@"
    done
    if [[ -z "$first_non_flag" && "$arg" != -* ]]; then
        first_non_flag="$arg"
    fi
done

if [[ -n "$first_non_flag" ]]; then
    for subcmd in $SUBCOMMANDS; do
        [[ "$first_non_flag" == "$subcmd" ]] && exec claude "$@"
    done
fi

# --- First invocation: generate marker and re-exec to embed it ---
if [[ -z "$MARKER" ]]; then
    MARKER="$(uuidgen)"
    exec "$0" --zellij-marker "$MARKER" "$@"
fi

mkdir -p "$MARKER_DIR"
MARKER_FILE="$MARKER_DIR/$MARKER"

# --- Resume existing marker or start a fresh Claude session ---
if [[ -f "$MARKER_FILE" ]]; then
    SESSION_ID="$(cat "$MARKER_FILE")"
    if [[ -n "$SESSION_ID" ]]; then
        CLAUDE_CMD=(claude --resume "$SESSION_ID")
        start_history_watcher "$MARKER_FILE" "$SESSION_ID"
        launch_claude_with_hotkey "$MARKER" "$@"
    fi
    CLAUDE_CMD=(claude --continue)
    launch_claude_with_hotkey "$MARKER" "$@"
fi

CLAUDE_UUID="$(uuidgen)"
echo "$CLAUDE_UUID" > "$MARKER_FILE"
CLAUDE_CMD=(claude --session-id "$CLAUDE_UUID" "$@")
start_history_watcher "$MARKER_FILE" "$CLAUDE_UUID"
launch_claude_with_hotkey "$MARKER" "$@"
