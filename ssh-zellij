#!/usr/bin/env python3
"""ssh-zellij: ssh that reconnects in place with Ctrl+Y.

Usage: ssh-zellij [ssh options] destination [command]

Plain ssh cannot tell that its link died. Without ServerAliveInterval it waits
for the kernel: about 15 minutes of retransmitting your keystrokes, or 2 hours
of TCP keepalive when idle. Meanwhile the terminal is in raw mode, so every key,
Ctrl+C included, goes to the dead connection and the pane looks frozen.

ssh-zellij runs ssh inside a small PTY proxy:

  * Ctrl+Y drops the current connection, even a hung one, and reconnects in
    the same pane.
  * A lost connection reconnects automatically with backoff. Sessions started
    with a remote command wait for Ctrl+Y or Enter instead of re-running it.
  * ServerAliveInterval=10 and ConnectTimeout=10 are added unless your ssh
    configuration sets them, so a dead link ends ssh in about 40 seconds.
  * Modes a dead remote program left on (alternate screen, mouse reporting,
    hidden cursor, ...) are reset before reconnecting.
  * A normal logout exits with ssh's status, like plain ssh.

Environment:
  SSH_ZELLIJ_KEY   reconnect key: ^Y (default), any ^A..^Z, ^], ^\\, or "none"
  SSH_ZELLIJ_AUTO  1 = always reconnect automatically, 0 = never
                   (default: only sessions without a remote command)
"""

from __future__ import annotations

import fcntl
import math
import os
import re
import select
import signal
import subprocess
import sys
import termios
import time
import tty

PROG = "ssh-zellij"
SSH = "ssh"
DEFAULT_KEY = "^Y"
ALIVE_INTERVAL = 10
CONNECT_TIMEOUT = 10
BACKOFF = (1, 2, 4, 8, 15, 30)
# A session that lasted this long was working: its loss restarts the backoff.
STABLE_SECONDS = 60
KILL_GRACE = 0.5
TAIL_BYTES = 4096

# OpenSSH options that take a value (getopt string of ssh 9.x), and options
# whose invocations are not interactive sessions: background (-f), config
# dump (-G), control commands (-O), queries (-Q), version (-V) and stdio
# forwarding (-W).
VALUE_OPTIONS = frozenset("BbcDEeFIiJLlmOoPpQRSWw")
PASSTHROUGH_OPTIONS = frozenset("fGOQVW")

# ssh's last words when retrying would fail the same way, and could lock the
# account out (fail2ban) if repeated automatically.
FATAL_MESSAGES = (
    "Permission denied (",
    "Host key verification failed",
    "REMOTE HOST IDENTIFICATION HAS CHANGED",
    "Too many authentication failures",
    "Bad owner or permissions",
    "usage: ssh",
)
# Printed for a normal logout and for the ~. escape; a lost link says
# "closed by remote host", "not responding", "Broken pipe", ...
CLOSED_RE = re.compile(r"^Connection to \S+ closed\.$")
ANSI_RE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\-_])")

# Keys in kitty keyboard protocol (CSI u) and xterm modifyOtherKeys encoding.
# Zellij switches a pane to CSI u when the program in it asks for it.
CSI_U_RE = re.compile(rb"\x1b\[(\d+)(?::\d*)*(?:;(\d+)(?::(\d))?)?(?:;[\d:]*)?u")
MODIFY_OTHER_KEYS_RE = re.compile(rb"\x1b\[27;(\d+);(\d+)~")

# Undo modes a dead remote program may have left on in the pane: alternate
# screen, scroll region (DECSTBM homes the cursor, so save and restore it),
# attributes, hidden cursor, autowrap, mouse and focus reporting, bracketed
# paste, application cursor keys and keypad, and the kitty keyboard protocol.
TERMINAL_RESET = (
    b"\x1b[?1049l"
    b"\x1b7\x1b[r\x1b8"
    b"\x1b[0m\x1b[?25h\x1b[?7h"
    b"\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1005l\x1b[?1006l\x1b[?1015l"
    b"\x1b[?1004l\x1b[?2004l"
    b"\x1b[?1l\x1b>"
    b"\x1b[<u"
)


def parse_key(spec: str) -> int | None:
    """Return the control byte for "^Y" / "ctrl+y" / "C-y", or None for "none"."""
    text = spec.strip()
    if text.lower() in ("", "none", "off", "0"):
        return None
    match = re.fullmatch(r"(?:\^|c-|ctrl[-+])(.)", text, re.IGNORECASE)
    code = ord(match.group(1).upper()) if match else -1
    if not 0x40 <= code <= 0x5F:
        raise ValueError(f"unsupported key {spec!r} (use ^Y, ctrl+y or none)")
    return code - 0x40


def key_name(code: int | None) -> str:
    return "" if code is None else "Ctrl+" + chr(code + 0x40)


def ctrl_only(modifiers: int) -> bool:
    # Kitty encodes modifiers as 1 + bits; caps lock (64) and num lock (128)
    # do not change which key was meant.
    return (modifiers - 1) & ~(64 | 128) == 4


def find_key(data: bytes, code: int) -> tuple[int, int] | None:
    """Locate Ctrl+<key> in terminal input; return its (start, end) or None."""
    hits = []
    raw = data.find(bytes([code]))
    if raw >= 0:
        hits.append((raw, raw + 1))
    point = ord(chr(code + 0x40).lower())
    for match in CSI_U_RE.finditer(data):
        modifiers = int(match.group(2) or 1)
        if int(match.group(1)) == point and ctrl_only(modifiers) and match.group(3) in (None, b"1", b"2"):
            hits.append(match.span())
            break
    for match in MODIFY_OTHER_KEYS_RE.finditer(data):
        if int(match.group(2)) == point and ctrl_only(int(match.group(1))):
            hits.append(match.span())
            break
    return min(hits) if hits else None


def legacy_keys(data: bytes) -> bytes:
    """Translate CSI u / modifyOtherKeys key events to the bytes a legacy terminal sends."""

    def translate(point: int, modifiers: int, event: bytes | None) -> bytes:
        if event == b"3" or point >= 128:  # key release, or not plain ASCII
            return b""
        if ctrl_only(modifiers) and 0x40 <= ord(chr(point).upper()) <= 0x5F:
            return bytes([ord(chr(point).upper()) - 0x40])
        if (modifiers - 1) & ~(64 | 128) == 0:
            return bytes([point])
        return b""

    data = CSI_U_RE.sub(lambda m: translate(int(m.group(1)), int(m.group(2) or 1), m.group(3)), data)
    return MODIFY_OTHER_KEYS_RE.sub(lambda m: translate(int(m.group(2)), int(m.group(1)), None), data)


def prompt_action(data: bytes, key: int | None) -> str | None:
    """Interpret a key press at the reconnect prompt: "reconnect", "quit" or None."""
    if key is not None and find_key(data, key) is not None:
        return "reconnect"
    for byte in legacy_keys(data):
        if byte in b"\r\nrR":
            return "reconnect"
        if byte in b"\x03\x04qQ":
            return "quit"
    return None


def parse_ssh_args(args: list[str]) -> tuple[str | None, list[str], set[str]]:
    """Split ssh arguments the way OpenSSH does: (destination, remote command, option letters).

    OpenSSH keeps parsing options after the destination, so "ssh host -p 2222"
    has no remote command, while "--" ends option parsing.
    """
    letters: set[str] = set()
    destination = None
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            index += 1
            if destination is None and index < len(args):
                destination = args[index]
                index += 1
            return destination, args[index:], letters
        if arg.startswith("-") and len(arg) > 1:
            for position in range(1, len(arg)):
                letter = arg[position]
                letters.add(letter)
                if letter in VALUE_OPTIONS:
                    if position == len(arg) - 1:
                        index += 1  # the value is the next argument
                    break
            index += 1
            continue
        if destination is None:
            destination = arg
            index += 1
            continue
        return destination, args[index:], letters
    return destination, [], letters


def ssh_config(args: list[str]) -> dict[str, str] | None:
    """Effective ssh configuration from "ssh -G", or None if ssh rejects the arguments."""
    try:
        result = subprocess.run(
            [SSH, "-G", *args],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    config: dict[str, str] = {}
    for line in result.stdout.decode("utf-8", "replace").splitlines():
        name, _, value = line.partition(" ")
        config.setdefault(name.lower(), value)
    return config


def ssh_command(args: list[str], config: dict[str, str]) -> list[str]:
    """ssh command line with dead-link detection unless the user configured it."""
    explicit = " ".join(args).lower()
    extra = []
    if config.get("serveraliveinterval", "0") == "0" and "serveraliveinterval" not in explicit:
        extra += ["-o", f"ServerAliveInterval={ALIVE_INTERVAL}"]
    if config.get("connecttimeout", "none") == "none" and "connecttimeout" not in explicit:
        extra += ["-o", f"ConnectTimeout={CONNECT_TIMEOUT}"]
    return [SSH, *extra, *args]


def classify(code: int | None, signum: int | None, tail: bytes) -> str:
    """Why ssh ended: "exit" (normal), "lost", "fatal", "closed" or "signal"."""
    if signum is not None:
        return "signal"
    if code != 255:
        return "exit"
    text = ANSI_RE.sub("", tail.decode("utf-8", "replace"))
    lines = [line.strip() for line in re.split(r"[\r\n]+", text) if line.strip()]
    last = lines[-3:]
    if any(message in line for line in last for message in FATAL_MESSAGES):
        return "fatal"
    if lines and CLOSED_RE.match(lines[-1]):
        return "closed"
    return "lost"


def get_winsize(fd: int) -> bytes | None:
    try:
        return fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
    except OSError:
        return None


def set_winsize(fd: int, winsize: bytes | None) -> None:
    if winsize is None:
        return
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)
    except OSError:
        pass


def write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except BlockingIOError:
            select.select([], [fd], [])
            continue
        view = view[written:]


def exec_ssh(args: list[str]) -> None:
    try:
        os.execvp(SSH, [SSH, *args])
    except OSError as error:
        print(f"{PROG}: cannot run {SSH}: {error}", file=sys.stderr)
        raise SystemExit(127)


def _ignore(_signum: int, _frame: object) -> None:
    pass  # the wakeup fd carries the signal into the select loop


def _terminate(signum: int, _frame: object) -> None:
    raise SystemExit(128 + signum)


class Proxy:
    """Relay a pane to ssh on a private PTY and restart ssh on demand."""

    def __init__(self, command: list[str], label: str, key: int | None, auto: bool,
                 stdin: int = 0, stdout: int = 1) -> None:
        self.command = command
        self.label = label
        self.key = key
        self.auto = auto
        self.stdin = stdin
        self.stdout = stdout
        self.color = not os.environ.get("NO_COLOR")
        self.attrs: list | None = None
        self.pid: int | None = None
        self.master: int | None = None
        self.exit: tuple[int | None, int | None] = (255, None)
        self.pending = bytearray()  # keyboard input ssh has not taken yet
        self.tail = bytearray()  # last output of the current ssh, to classify its exit
        self.wake_r = -1

    # --- messages ---------------------------------------------------------

    def styled(self, text: str, style: str) -> str:
        line = f"[{PROG}] {text}"
        return f"\x1b[{style}m{line}\x1b[0m" if self.color else line

    def say(self, text: str, style: str = "33") -> None:
        write_all(self.stdout, (self.styled(text, style) + "\r\n").encode())

    def status(self, text: str) -> None:
        write_all(self.stdout, ("\r\x1b[K" + self.styled(text, "33")).encode())

    def reset_terminal(self) -> None:
        """Undo modes the remote program left on, and start messages on a fresh line."""
        newline = b"" if self.tail.endswith(b"\n") else b"\r\n"
        write_all(self.stdout, TERMINAL_RESET + newline)

    # --- child process ----------------------------------------------------

    def start_child(self) -> None:
        self.close_master()
        master, slave = os.openpty()
        if self.attrs is not None:
            try:
                # ssh copies these modes to the remote PTY, as if it ran in the pane.
                termios.tcsetattr(slave, termios.TCSANOW, self.attrs)
            except termios.error:
                pass
        set_winsize(slave, get_winsize(self.stdin))
        pid = os.fork()
        if pid == 0:
            try:
                os.close(master)
                os.setsid()
                fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
                for fd in (0, 1, 2):
                    os.dup2(slave, fd)
                if slave > 2:
                    os.close(slave)
                # Python ignores these; exec would keep them ignored for ssh.
                signal.signal(signal.SIGPIPE, signal.SIG_DFL)
                signal.signal(signal.SIGXFSZ, signal.SIG_DFL)
                os.execvp(self.command[0], self.command)
            except BaseException as error:  # noqa: BLE001 - report anything, then exit
                try:
                    os.write(2, f"{PROG}: cannot run {self.command[0]}: {error}\r\n".encode())
                except OSError:
                    pass
            os._exit(127)
        os.close(slave)
        os.set_blocking(master, False)
        self.pid, self.master = pid, master
        self.pending.clear()
        self.tail.clear()

    def poll_child(self, block: bool = False) -> tuple[int | None, int | None] | None:
        """Reap ssh if it exited: (exit code, None) or (None, signal); None while it runs."""
        if self.pid is None:
            return self.exit
        try:
            pid, status = os.waitpid(self.pid, 0 if block else os.WNOHANG)
        except ChildProcessError:
            pid, status = self.pid, 255 << 8
        if pid == 0:
            return None
        self.pid = None
        if os.WIFSIGNALED(status):
            self.exit = (None, os.WTERMSIG(status))
        else:
            self.exit = (os.WEXITSTATUS(status), None)
        return self.exit

    def stop_child(self) -> None:
        """End ssh and everything in its process group (ProxyCommand, ...)."""
        if self.pid is not None:
            group = self.pid
            for signum in (signal.SIGTERM, signal.SIGCONT):
                try:
                    os.killpg(group, signum)
                except OSError:
                    pass
            deadline = time.monotonic() + KILL_GRACE
            while self.poll_child() is None:
                if time.monotonic() >= deadline:
                    try:
                        os.killpg(group, signal.SIGKILL)
                    except OSError:
                        pass
                    self.poll_child(block=True)
                    break
                time.sleep(0.02)
        self.close_master()

    def close_master(self) -> None:
        if self.master is not None:
            try:
                os.close(self.master)
            except OSError:
                pass
            self.master = None

    # --- I/O ----------------------------------------------------------------

    def read_stdin(self) -> bytes:
        try:
            data = os.read(self.stdin, 65536)
        except OSError:
            data = b""
        if not data:
            raise SystemExit(0)  # the pane is gone; run() stops ssh
        return data

    def read_master(self) -> bytes | None:
        """Output from ssh; b"" once its terminal is closed, None if nothing is ready."""
        try:
            return os.read(self.master, 65536)
        except BlockingIOError:
            return None
        except OSError:  # EIO: every slave descriptor is closed
            return b""

    def show(self, chunk: bytes) -> None:
        write_all(self.stdout, chunk)
        self.tail += chunk
        if len(self.tail) > TAIL_BYTES:
            del self.tail[:-TAIL_BYTES]

    def flush_input(self) -> None:
        while self.pending and self.master is not None:
            try:
                written = os.write(self.master, self.pending)
            except BlockingIOError:
                return
            except OSError:
                self.pending.clear()
                return
            del self.pending[:written]

    def drain_output(self) -> None:
        """After ssh exited, show what it printed last (its error message)."""
        for _ in range(256):
            if not select.select([self.master], [], [], 0.2)[0]:
                return
            chunk = self.read_master()
            if not chunk:
                return
            self.show(chunk)

    def drain_wakeups(self) -> None:
        signals = b""
        while True:
            try:
                data = os.read(self.wake_r, 512)
            except BlockingIOError:
                break
            if not data:
                break
            signals += data
        if signal.SIGWINCH in signals and self.master is not None:
            set_winsize(self.master, get_winsize(self.stdin))

    # --- states -------------------------------------------------------------

    def relay(self) -> tuple[int | None, int | None] | None:
        """Relay bytes until ssh exits (its status) or the reconnect key is pressed (None)."""
        while True:
            writers = [self.master] if self.pending else []
            readers, _, _ = select.select([self.stdin, self.master, self.wake_r], writers, [])
            if self.wake_r in readers:
                self.drain_wakeups()
                status = self.poll_child()
                if status is not None:
                    self.drain_output()
                    return status
            if self.stdin in readers:
                data = self.read_stdin()
                hit = find_key(data, self.key) if self.key is not None else None
                if hit is not None:
                    self.pending += data[: hit[0]]
                    self.flush_input()
                    self.stop_child()
                    return None
                self.pending += data
            self.flush_input()
            if self.master in readers:
                chunk = self.read_master()
                if chunk:
                    self.show(chunk)
                elif chunk == b"":
                    deadline = time.monotonic() + 2.0
                    while (status := self.poll_child()) is None:
                        if time.monotonic() >= deadline:
                            self.stop_child()
                            return self.exit
                        time.sleep(0.02)
                    return status

    def prompt(self, delay: float | None) -> bool:
        """Wait for a key or the backoff timer: True to reconnect, False to quit."""
        keys = f"{key_name(self.key)}/Enter" if self.key is not None else "Enter"
        deadline = None if delay is None else time.monotonic() + delay
        shown = None
        try:
            while True:
                timeout = None
                if deadline is not None:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        return True
                    seconds = math.ceil(remaining)
                    if seconds != shown:
                        shown = seconds
                        self.status(f"Reconnecting in {seconds}s | {keys}: now | q: quit")
                    timeout = remaining - (seconds - 1)
                elif shown is None:
                    shown = 0
                    self.status(f"{keys}: reconnect | q: quit")
                readers, _, _ = select.select([self.stdin, self.wake_r], [], [], timeout)
                if self.wake_r in readers:
                    self.drain_wakeups()
                if self.stdin in readers:
                    action = prompt_action(self.read_stdin(), self.key)
                    if action is not None:
                        return action == "reconnect"
        finally:
            write_all(self.stdout, b"\r\n")

    def loop(self) -> int:
        hints = []
        if self.key is not None:
            hints.append(f"{key_name(self.key)} reconnects this pane")
        if self.auto:
            hints.append("lost connections reconnect automatically")
        if hints:
            self.say("; ".join(hints) + ".", style="2")
        failures = 0
        while True:
            started = time.monotonic()
            self.start_child()
            result = self.relay()
            if result is None:
                self.reset_terminal()
                self.say(f"{key_name(self.key)}: reconnecting to {self.label}...")
                failures = 0
                continue
            code, signum = result
            kind = classify(code, signum, bytes(self.tail))
            if kind == "exit":
                return code
            self.reset_terminal()
            delay = None
            if kind == "lost":
                failures = 0 if time.monotonic() - started >= STABLE_SECONDS else failures + 1
                self.say(f"Connection to {self.label} lost (ssh exit {code}).")
                if self.auto:
                    delay = BACKOFF[min(failures, len(BACKOFF) - 1)]
            elif kind == "fatal":
                self.say("ssh failed with an authentication, host key or configuration error; "
                         "not reconnecting automatically.")
            elif kind == "signal":
                self.say(f"ssh was terminated by signal {signum}.")
            if not self.prompt(delay):
                return code if signum is None else 128 + signum
            self.say(f"Reconnecting to {self.label}...")

    def run(self) -> int:
        self.attrs = termios.tcgetattr(self.stdin)
        self.wake_r, wake_w = os.pipe()
        os.set_blocking(self.wake_r, False)
        os.set_blocking(wake_w, False)
        previous_wakeup = signal.set_wakeup_fd(wake_w, warn_on_full_buffer=False)
        previous = {signum: signal.signal(signum, _ignore) for signum in (signal.SIGWINCH, signal.SIGCHLD)}
        previous.update({signum: signal.signal(signum, _terminate) for signum in (signal.SIGHUP, signal.SIGTERM)})
        try:
            tty.setraw(self.stdin)
            return self.loop()
        finally:
            self.stop_child()
            try:
                termios.tcsetattr(self.stdin, termios.TCSADRAIN, self.attrs)
            except termios.error:
                pass
            for signum, handler in previous.items():
                signal.signal(signum, handler)
            signal.set_wakeup_fd(previous_wakeup)
            os.close(self.wake_r)
            os.close(wake_w)


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--help"]:
        print(__doc__.strip())
        return 0
    destination, command, letters = parse_ssh_args(args)
    if destination is None or letters & PASSTHROUGH_OPTIONS or not (os.isatty(0) and os.isatty(1)):
        exec_ssh(args)
    try:
        key = parse_key(os.environ.get("SSH_ZELLIJ_KEY", DEFAULT_KEY))
    except ValueError as error:
        print(f"{PROG}: {error}; using {DEFAULT_KEY}", file=sys.stderr)
        key = parse_key(DEFAULT_KEY)
    config = ssh_config(args)
    if config is None:
        exec_ssh(args)  # let ssh report the bad option or configuration itself
    auto = {"1": True, "0": False}.get(os.environ.get("SSH_ZELLIJ_AUTO", ""), not command)
    return Proxy(ssh_command(args, config), destination, key, auto).run()


if __name__ == "__main__":
    raise SystemExit(main())
